DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
PORT=3000
SUPABASE_URL=http://127.0.0.1:54321
# Optional: enable legacy HS256 verification using JWT_SECRET from local supabase status.
# ES256 uses the public JWKS endpoint and does not need this secret.
SUPABASE_JWT_SECRET=
SUPABASE_SECRET_KEY=
EMAIL_PROVIDER=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=54325
INVITATION_ACCEPT_URL=http://localhost:5173
EXPOSE_INVITE_TOKEN_FOR_TEST=false
