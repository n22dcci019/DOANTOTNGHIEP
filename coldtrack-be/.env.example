# Copy to .env; local secrets are generated by npm run local:configure.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
API_PORT=3000
INGEST_PORT=3001
WORKER_PORT=3002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure separate least-privilege database roles before business/ingest work.
# Local database addresses use port 54322. Never put a production URL here.
DATABASE_URL=
INGEST_DATABASE_URL=
WORKER_DATABASE_URL=

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Step 0.2 transport variables. Compose sets container paths/hostname itself.
# For a host process, use the generated files relative to coldtrack-be/.
MQTT_URL=mqtts://localhost:8883
MQTT_CA_FILE=infra/mosquitto/certs/ca.crt
MQTT_USERNAME=coldtrack-test
MQTT_PASSWORD_FILE=infra/mosquitto/secrets/test-password
# Legacy infrastructure credential names; unused by step 0.2 transports.
MQTT_INGEST_USERNAME=coldtrack-ingest
MQTT_INGEST_PASSWORD=
MQTT_WORKER_USERNAME=coldtrack-worker
MQTT_WORKER_PASSWORD=

TELEMETRY_INTERVAL_SECONDS=15
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_VEHICLES=5
STALE_AFTER_SECONDS=60
SIGNAL_LOST_AFTER_SECONDS=300
TELEMETRY_RETENTION_DAYS=7
