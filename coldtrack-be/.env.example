# Copy to .env; local secrets are generated by npm run local:configure.
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
API_PORT=3000
INGEST_PORT=3001
WORKER_PORT=3002
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configure separate least-privilege database roles before business/ingest work.
# Local database addresses use port 54322. Never put a production URL here.
DATABASE_URL=
INGEST_DATABASE_URL=
WORKER_DATABASE_URL=

SUPABASE_URL=http://127.0.0.1:54321
# Optional legacy HS256 verification; copy JWT_SECRET from local supabase status.
# ES256 verification uses SUPABASE_URL/auth/v1/.well-known/jwks.json.
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local invitations only. Supabase Mailpit SMTP port must be reachable from API.
EMAIL_PROVIDER=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=54325
INVITATION_ACCEPT_URL=http://localhost:5173
# Effective only with NODE_ENV=test; never enable in production.
EXPOSE_INVITE_TOKEN_FOR_TEST=false

# Compose supplies SERVICE_USER and SERVICE_PASSWORD from each service's env_file.
# For a host process, load the matching secrets/services/svc-*.env.
MQTT_URL=mqtts://localhost:8883
MQTT_CA_FILE=infra/mosquitto/certs/ca.crt
# Legacy infrastructure credential names; unused by step 0.2 transports.
MQTT_INGEST_USERNAME=coldtrack-ingest
MQTT_INGEST_PASSWORD=
MQTT_WORKER_USERNAME=coldtrack-worker
MQTT_WORKER_PASSWORD=

TELEMETRY_INTERVAL_SECONDS=15
SIMULATOR_INTERVAL_SECONDS=30
SIMULATOR_VEHICLES=5
STALE_AFTER_SECONDS=60
SIGNAL_LOST_AFTER_SECONDS=300
TELEMETRY_RETENTION_DAYS=7
