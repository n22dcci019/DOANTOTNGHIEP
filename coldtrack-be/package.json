{
  "name": "coldtrack-be",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:ingest": "tsx watch apps/ingest/src/main.ts",
    "dev:worker": "tsx watch apps/worker/src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start:api": "node dist/apps/api/src/main.js",
    "start:ingest": "node dist/apps/ingest/src/main.js",
    "start:worker": "node dist/apps/worker/src/main.js",
    "format:check": "prettier --check apps libs scripts *.json *.md",
    "format": "prettier --write apps libs scripts *.json *.md",
    "supabase": "supabase",
    "db:start": "supabase start --exclude studio,postgres-meta,logflare,vector,edge-runtime --workdir ..",
    "db:start:full": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:status": "supabase status --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "db:migration": "supabase migration new --workdir ..",
    "db:seed": "tsx scripts/seed-demo.ts",
    "device:provision": "tsx scripts/provision-device-credentials.ts",
    "svc:provision": "tsx scripts/provision-service-credentials.ts",
    "mqtt:sync": "tsx scripts/sync-mosquitto.ts",
    "db:types": "kysely-codegen --env-file ../.env --dialect postgres --include-pattern \"public.*\" --out-file libs/database/schema.ts --log-level info",
    "db:types:check": "npm run db:reset && npm run db:types -- --verify",
    "mqtt:up": "docker compose up -d mosquitto",
    "mqtt:down": "docker compose stop mosquitto",
    "local:configure": "node scripts/configure-local.mjs",
    "check:local": "node scripts/check-local.mjs",
    "lint": "eslint apps libs test \"scripts/*.ts\"",
    "test": "npm run db:reset && npm run test:core && npm run test:profiles && npm run test:shipments && npm run test:trips && npm run test:temperature-configs && npm run test:seed && npm run test:mqtt",
    "test:core": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=seed-bootstrap --testPathIgnorePatterns=mqtt-credentials --testPathIgnorePatterns=profiles-invitations --testPathIgnorePatterns=shipments-api --testPathIgnorePatterns=trips-api --testPathIgnorePatterns=temperature-configs",
    "test:profiles": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath .test-dist/test/profiles-invitations.integration.test.js",
    "test:shipments": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath .test-dist/test/shipments-api.integration.test.js",
    "test:trips": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath .test-dist/test/trips-api.integration.test.js",
    "test:temperature-configs": "tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath .test-dist/test/temperature-configs.integration.test.js",
    "test:mqtt": "npm run device:provision && npm run svc:provision && npm run mqtt:sync && docker compose up -d mosquitto mosquitto-test && docker compose restart mosquitto && tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath .test-dist/test/mqtt-credentials.integration.test.js",
    "test:seed": "npm run db:reset && npm run db:seed && tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --runTestsByPath .test-dist/test/seed-bootstrap.integration.test.js"
  },
  "dependencies": {
    "@nestjs/common": "12.4.2",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "12.4.2",
    "@nestjs/platform-express": "12.4.2",
    "@nestjs/swagger": "12.1.1",
    "@supabase/supabase-js": "2.119.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.10",
    "helmet": "8.3.0",
    "jose": "6.2.17",
    "kysely": "0.29.8",
    "mqtt": "5.16.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "kysely-codegen": "0.20.0",
    "prettier": "3.10.1",
    "supabase": "3.1.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
